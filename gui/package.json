{
  "name": "acoustic-vision-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Acoustic-Vision GUI (Electron + Vue 3 + Three.js) — talks to av-api over REST/WS /v1",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "three": "^0.186.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^10.0.0",
    "electron": "^33.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "wait-on": "^9.0.0"
  }
}
