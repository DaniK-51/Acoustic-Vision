# Unit cube [0,1]^3, 8 vertices, 12 triangles (2 per face).
# Winding is CCW seen from outside; importers flip to the into-room /
# toward-air normal convention if a room shell is intended (mesh.hpp).
# Groups name material zones for materialOverrides tests.
v 0.0 0.0 0.0
v 1.0 0.0 0.0
v 1.0 1.0 0.0
v 0.0 1.0 0.0
v 0.0 0.0 1.0
v 1.0 0.0 1.0
v 1.0 1.0 1.0
v 0.0 1.0 1.0

g floor
# z = 0 face (two triangles)
f 1 2 3
f 1 3 4

g ceiling
# z = 1 face
f 5 8 7
f 5 7 6

g walls
# x = 0
f 1 5 8
f 1 8 4
# x = 1
f 2 3 7
f 2 7 6
# y = 0
f 1 2 6
f 1 6 5
# y = 1
f 4 8 7
f 4 7 3
