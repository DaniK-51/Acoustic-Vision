{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acoustic-vision.local/schemas/source-catalog.schema.json",
  "title": "Acoustic-Vision Source Catalog",
  "description": "Built-in loudspeaker/source cards, consumed as-is. Values are fact-shaped placeholders (typical public datasheet-style), not verified vendor data — see the required disclaimer fields.",
  "type": "object",
  "required": ["disclaimer", "sources"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "description": "Catalog-wide disclaimer; always present in GET /v1/source-catalog."
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "powerDb", "spectrum", "directivity", "disclaimer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": {
          "type": "string",
          "description": "Optional. Omit for generic/placeholder cards."
        },
        "category": {
          "type": "string",
          "description": "Free-form grouping, e.g. studio-monitor | pa | omni | dipole."
        },
        "powerDb": {
          "type": "number",
          "description": "Rated/typical maximum sound pressure level in dB SPL referenced to 1 m on-axis (NOT electrical watts). Example values only."
        },
        "spectrum": {
          "type": "object",
          "required": ["bandsHz", "responseDb"],
          "description": "Relative level offsets (dB) of the source against its broadband powerDb, one value per band.",
          "properties": {
            "bandsHz": {
              "type": "array",
              "items": { "type": "number", "exclusiveMinimum": 0 },
              "minItems": 1
            },
            "responseDb": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 1,
              "description": "Same length as bandsHz."
            }
          }
        },
        "directivity": {
          "type": "object",
          "required": ["type"],
          "description": "Card radiation pattern. type is the analytic family (omni|dipole|cardioid|custom); horizontal/vertical are optional polar curves (azimuth / elevation plane). When curves are omitted, consumers may fall back to an analytic preset for omni/dipole/cardioid — 'custom' without curves has no pattern. Curves are relative gains: 0 dB is the on-axis reference of the card, not an absolute level. polarCurve layout: freqsHz[i] owns gainDb[i]; each gainDb row is sampled at anglesDeg and must have the same length. Example: freqsHz [125,250,500,1000,2000,4000], anglesDeg [-180,-150,...,180], gainDb = 6 rows x 25 columns.",
          "properties": {
            "type": { "enum": ["omni", "dipole", "cardioid", "custom"] },
            "description": { "type": "string" },
            "horizontal": {
              "type": "object",
              "required": ["freqsHz", "anglesDeg", "gainDb"],
              "properties": {
                "freqsHz": {
                  "type": "array",
                  "items": { "type": "number", "exclusiveMinimum": 0 },
                  "minItems": 1
                },
                "anglesDeg": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 1
                },
                "gainDb": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": "number" }
                  },
                  "minItems": 1
                }
              }
            },
            "vertical": {
              "type": "object",
              "required": ["freqsHz", "anglesDeg", "gainDb"],
              "properties": {
                "freqsHz": {
                  "type": "array",
                  "items": { "type": "number", "exclusiveMinimum": 0 },
                  "minItems": 1
                },
                "anglesDeg": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 1
                },
                "gainDb": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": "number" }
                  },
                  "minItems": 1
                }
              }
            }
          }
        },
        "notes": { "type": "string" },
        "sourceUrl": {
          "type": "string",
          "description": "Optional reference URL; omit rather than invent one."
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1,
          "description": "Per-card disclaimer (required)."
        }
      }
    }
  }
}
