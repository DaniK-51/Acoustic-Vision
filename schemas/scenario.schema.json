{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acoustic-vision.local/schemas/scenario.schema.json",
  "title": "Acoustic-Vision Scenario",
  "type": "object",
  "required": ["room", "materials", "params"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "room": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["rect", "mesh"] },
        "size": {
          "type": "object",
          "properties": {
            "w": { "type": "number", "exclusiveMinimum": 0 },
            "h": { "type": "number", "exclusiveMinimum": 0 },
            "d": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "faces": {
          "type": "object",
          "properties": {
            "floor": { "type": "string" },
            "ceiling": { "type": "string" },
            "x+": { "type": "string" },
            "x-": { "type": "string" },
            "z+": { "type": "string" },
            "z-": { "type": "string" }
          }
        },
        "mesh": {
          "type": "object",
          "properties": {
            "uri": { "type": "string" },
            "unit": { "enum": ["m", "mm", "cm", "in"] },
            "scale": { "type": "number", "exclusiveMinimum": 0 },
            "materialOverrides": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "absorption"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "bandsHz": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
          "absorption": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "scattering": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "position"],
        "properties": {
          "id": { "type": "string" },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "powerDb": { "type": "number" },
          "orientation": {
            "type": "object",
            "description": "Optional source aim. yawDeg rotates about +Y: 0 faces +Z, positive turns toward +X. pitchDeg tilts up/down: positive looks up. Both default to 0 when omitted.",
            "properties": {
              "yawDeg": { "type": "number" },
              "pitchDeg": { "type": "number" }
            }
          },
          "directivity": { "$ref": "#/$defs/directivity" }
        }
      }
    },
    "receivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "position"],
        "properties": {
          "id": { "type": "string" },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "params": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": { "type": "string" },
        "maxReflectionOrder": { "type": "integer", "minimum": 1, "maximum": 32 },
        "sampleRate": { "type": "integer", "minimum": 1000 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "bandsHz": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "speedOfSound": { "type": "number", "exclusiveMinimum": 0 },
        "capturePaths": { "type": "boolean" },
        "airAbsorption": { "type": "boolean" },
        "signedIr": { "type": "boolean" },
        "methodParams": { "type": "object" },
        "fieldGrid": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "nx": { "type": "integer", "minimum": 1, "maximum": 64 },
            "ny": { "type": "integer", "minimum": 1, "maximum": 64 },
            "nz": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        }
      }
    }
  },
  "$defs": {
    "directivity": {
      "type": "object",
      "required": ["type"],
      "description": "Source/catalog radiation pattern. type is the analytic family (omni|dipole|cardioid|custom); horizontal/vertical are optional polar curves (azimuth / elevation plane). When curves are omitted, consumers may fall back to an analytic preset for omni/dipole/cardioid — 'custom' without curves has no pattern. Curves are relative gains: 0 dB is the on-axis reference of the source, not an absolute level.",
      "properties": {
        "type": { "enum": ["omni", "dipole", "cardioid", "custom"] },
        "description": { "type": "string" },
        "horizontal": { "$ref": "#/$defs/polarCurve" },
        "vertical": { "$ref": "#/$defs/polarCurve" }
      }
    },
    "polarCurve": {
      "type": "object",
      "required": ["freqsHz", "anglesDeg", "gainDb"],
      "description": "Polar curve set: gain (dB) vs angle, one curve per band. freqsHz[i] owns gainDb[i]; each gainDb row is sampled at anglesDeg and must have the same length. Example: freqsHz [125,250,500,1000,2000,4000], anglesDeg [-180,-150,...,180], gainDb = 6 rows x 25 columns.",
      "properties": {
        "freqsHz": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 1
        },
        "anglesDeg": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "gainDb": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          },
          "minItems": 1
        }
      }
    }
  }
}
